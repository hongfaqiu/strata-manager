diff --git a/.github/workflows/upstream-sentinel.yml b/.github/workflows/upstream-sentinel.yml
new file mode 100644
index 0000000..85af2ea
--- /dev/null
+++ b/.github/workflows/upstream-sentinel.yml
@@ -0,0 +1,57 @@
+name: Upstream Strata sentinel
+
+# Daily: check upstream main and the latest release against the observer contract.
+# A compatible new release opens a PR adding its reviewed hash; an incompatible
+# one opens an issue. Nothing is merged automatically.
+on:
+  schedule:
+    - cron: '17 3 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  pull-requests: write
+  issues: write
+
+jobs:
+  sentinel:
+    runs-on: ubuntu-22.04
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.10'
+      - run: python -m pip install jinja2==3.1.6 markupsafe==3.0.3
+      - name: Fetch the latest upstream release
+        id: latest
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          tag=$(gh api repos/Niko1221/Strata/releases/latest --jq .tag_name)
+          ref=$(gh api repos/Niko1221/Strata/commits/$tag --jq .sha)
+          echo "tag=$tag" >> "$GITHUB_OUTPUT"; echo "ref=$ref" >> "$GITHUB_OUTPUT"
+          git clone --depth 1 --branch "$tag" https://github.com/Niko1221/Strata .reference/strata-latest
+      - name: Structural and HTTP contracts against the latest release
+        id: check
+        env:
+          STRATA_TEST_ROOT: ${{ github.workspace }}/.reference/strata-latest
+          STRATA_CHECK_UPSTREAM_MAIN: '1'
+        run: |
+          python scripts/observer-sentinel.py "${{ steps.latest.outputs.tag }}" "${{ steps.latest.outputs.ref }}"
+      - name: Open a PR for a compatible unreviewed release
+        if: steps.check.outputs.result == 'added'
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          branch="sentinel/strata-${{ steps.latest.outputs.tag }}"
+          git config user.name github-actions; git config user.email github-actions@users.noreply.github.com
+          git checkout -b "$branch"; git commit -am "compat: review Strata ${{ steps.latest.outputs.tag }} observer source"
+          git push origin "$branch"
+          gh pr create --title "compat: Strata ${{ steps.latest.outputs.tag }} observer source" --body "Structural detection and the full MockEngine HTTP suite passed. Review the server.py diff before merging."
+      - name: Open an issue for an incompatible release
+        if: failure()
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          gh issue create --title "Strata ${{ steps.latest.outputs.tag }} breaks the observer contract" --body "See ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}. Analytics fall back to public endpoints until reviewed."
